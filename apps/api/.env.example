# Copy to .env (never commit .env). Secrets live only on the server.

# Shared local Postgres (jepsn1/infra), DEV db 'biblestdy_dev' (prod db 'biblestdy' — see root .env.example). Password: /srv/infra/compose/.env
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/biblestdy_dev

# openssl rand -hex 32 — use a fresh one per environment
BETTER_AUTH_SECRET=CHANGE_ME

# Resend — dev sends real emails too (use the OTP code; dev magic links point at
# localhost and won't work off-box). Unset -> link/OTP logged to console instead.
RESEND_API_KEY=CHANGE_ME

# Optional (defaults shown)
# BETTER_AUTH_URL=http://localhost:5173
# PORT=3001
# API_BIBLE_KEY=   # unset -> FakeScriptureProvider (WEB fixtures)
