# Copy to .env (never commit .env). Secrets live only on the server.

# Shared local Postgres (jepsn1/infra), db 'biblestdy'. Password: /srv/infra/compose/.env
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/biblestdy

# openssl rand -hex 32 — use a fresh one per environment
BETTER_AUTH_SECRET=CHANGE_ME

