# PRODUCTION env for the api container (compose env_file). Copy to .env on the server.
# Dev env lives in apps/api/.env (see apps/api/.env.example).

# Shared Postgres via docker network 'web'. Password: /srv/infra/compose/.env
DATABASE_URL=postgresql://postgres:CHANGE_ME@infra-postgres:5432/biblestdy

# openssl rand -hex 32 — must differ from dev
BETTER_AUTH_SECRET=CHANGE_ME

BETTER_AUTH_URL=https://biblestdy.com
PORT=3001
# API_BIBLE_KEY=   # unset -> FakeScriptureProvider

# Resend (https://resend.com) — auth emails. Unset -> link/OTP logged to console.
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=biblestdy <auth@biblestdy.com>   # domain must be verified in Resend
